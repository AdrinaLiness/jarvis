<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.adrina.jarvis"
    android:versionCode="7"
    android:versionName="1.6">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- v1.2: напоминания и таймеры — системные уведомления.
         POST_NOTIFICATIONS запрашивается в рантайме на Android 13+.
         SCHEDULE_EXACT_ALARM — точные будильники на Android 12 (на 13+,
         если пользователь не выдал, используем неточный будильник). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.FLASHLIGHT"/>
    <!-- v1.5: телефон под командой. SMS: чтение входящих вслух (фон) +
         отправка. Контакты — имена вместо номеров. CALL_PHONE — прямой
         звонок по команде «позвони» (запрос в рантайме при первом звонке).
         FOREGROUND_SERVICE — тихий сервис озвучки СМС (Android 8+). -->
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <!-- Android 11+ (API 30): без этого блок видимость приложений —
         getLaunchIntentForPackage() возвращает null и запуск не работает.
       Разрешаем видеть все запускаемые приложения и обрабатывать http(s). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>

    <application
        android:label="J.A.R.V.I.S."
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:allowBackup="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Будильники напоминаний: срабатывают даже если приложение выгружено -->
        <receiver
            android:name=".NotifReceiver"
            android:exported="false"/>
        <!-- v1.5: входящие SMS в фоне. BROADCAST_SMS — только система может
             доставить в этот приёмник (защита от подделки другими приложениями). -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>
        <!-- v1.5: озвучка СМС (TTS); на Android 14+ — тип shortService -->
        <service
            android:name=".SmsSpeakerService"
            android:exported="false"
            android:foregroundServiceType="shortService"/>
        <!-- v1.5: отчёт о статусе отправки SMS -->
        <receiver
            android:name=".SmsSentReceiver"
            android:exported="false"/>
    </application>
</manifest>
